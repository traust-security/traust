#!/usr/bin/env bash
#
# Pre-commit guard: block a commit whose skills are misaligned with the
# cross-skill contracts (src/traust/cli/check_skill_alignment.py). Runs at
# commit time so a misaligned skill never exists in history; the heavier
# docs/licensing gates stay at pre-push. Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# To bypass in an emergency: git commit --no-verify
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
checker="$repo_root/src/traust/cli/check_skill_alignment.py"

# Activates rule A13 (staged SKILL.md must ship with a docs/skills.md
# refresh; waive with SKILLS_DOC_WAIVER=<reason>) — the rule is inert
# outside the hook so tests and plain tree checks are unaffected.
export HARNESS_PRE_COMMIT=1

# FAIL-CLOSED: a missing interpreter or checker blocks the commit.
# The deliberate escape hatch is `git commit --no-verify`.
if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 not found — the alignment/security gates" >&2
  echo "            CANNOT run, so the commit is blocked (fail-closed)." >&2
  echo "            Install python3, or bypass ONCE with --no-verify." >&2
  exit 1
fi

if [ ! -f "$checker" ]; then
  echo "pre-commit: $checker is MISSING — refusing to commit without" >&2
  echo "            the alignment gate (fail-closed)." >&2
  exit 1
fi
# C8 made the gates package modules (they import traust), so a
# bare `python3` that is not the repo venv fails with a ModuleNotFoundError
# rather than a real violation — which turns a fail-closed guard into a nudge
# toward --no-verify. Prefer the repo venv, fall back to python3.
py="python3"
if [ -x "$repo_root/.venv/bin/python" ]; then
  py="$repo_root/.venv/bin/python"
fi

if ! "$py" "$checker"; then
  echo "" >&2
  echo "pre-commit: skill-alignment check FAILED." >&2
  echo "            Fix the skill (see /check-alignment), then commit again." >&2
  echo "            To bypass: git commit --no-verify" >&2
  exit 1
fi

estate_checker="$repo_root/src/traust/cli/check_estate_data.py"
if [ ! -f "$estate_checker" ]; then
  echo "pre-commit: $estate_checker is MISSING — refusing to commit without" >&2
  echo "            the estate-data gate (fail-closed)." >&2
  exit 1
fi
if ! "$py" "$estate_checker" --staged --quiet; then
  echo "" >&2
  echo "pre-commit: estate-data check FAILED — this repo is PUBLIC." >&2
  echo "            Red Hat-specific material belongs in traust-internal/," >&2
  echo "            not here. MOVE it; do not scrub it — the figures are" >&2
  echo "            the record of what the script did and travel with it." >&2
  echo "            To bypass: git commit --no-verify" >&2
  exit 1
fi

sec_checker="$repo_root/src/traust/cli/check_skill_security.py"
if [ ! -f "$sec_checker" ]; then
  echo "pre-commit: $sec_checker is MISSING — refusing to commit without" >&2
  echo "            the security-posture gate (fail-closed)." >&2
  exit 1
fi
if ! "$py" "$sec_checker" --quiet; then
  echo "" >&2
  echo "pre-commit: skill security-posture check FAILED." >&2
  echo "            Fix the skill (see /check-skill-security), then commit again." >&2
  echo "            To bypass: git commit --no-verify" >&2
  exit 1
fi

# --- skill-discovery hint (read-only; audit E8, plan P1.8) ---
# The hook no longer writes into $HOME. If this clone's skills are
# symlinked into ~/.claude/skills and a NEW skill is unlinked, print a
# hint; linking is an explicit user action.
user_skills="${HOME}/.claude/skills"
opted_in=false
if [ -d "$user_skills" ]; then
  for link in "$user_skills"/*; do
    [ -L "$link" ] || continue
    case "$(readlink "$link")" in
      "$repo_root/harnessing/"*) opted_in=true; break ;;
    esac
  done
fi
if [ "$opted_in" = true ]; then
  # Two levels: a workflow skill sits under its stage directory, the rest at
  # the harnessing/ root — same walk as bin/link_skills.sh.
  for skill_dir in "$repo_root"/harnessing/*/ "$repo_root"/harnessing/*/*/; do
    [ -f "$skill_dir/SKILL.md" ] || continue
    name="$(basename "$skill_dir")"
    # Test the resolved SKILL.md, not the link: `-e` dereferences, so it
    # reads a dangling link as absent and a stale one (target dir survives
    # the skill's move, e.g. a leftover working tree) as healthy. One test
    # covers absent, dangling and stale alike.
    if [ ! -f "$user_skills/$name/SKILL.md" ]; then
      echo "pre-commit: NOTE skill '$name' is not linked in ~/.claude/skills — run bin/link_skills.sh"
    fi
  done
fi
