# traust environment variables
# Copy to .env and fill in values. Not all variables are needed —
# only those required by the skills you intend to run.

# ── Registry access (inventory-repositories, validate-operator-live) ──
# Base64-encoded Docker/Podman auth JSON with quay.io credentials
QUAY_TOKEN=

# ── GitHub (remediate-finding, inventory-repositories) ──
GITHUB_TOKEN=
# validation-sink repo (org/repo) for deploy-operator real-creds runs —
# deployment-specific, no shipped default
GITHUB_SINK_REPO=

# ── AWS (deploy-operator real-creds guard) ──
# account id the real-creds provisioner may operate in (fails closed if
# unset or mismatched)

# ── OpenShift / Kubernetes ──
KUBECONFIG=
OCP_PULL_SECRET_PATH=
OCP_SSH_PUBKEY=
OCP_VERSION=

# ── ROSA HCP (validate-operator-live) ──
ROSA_HCP_EPHEMERAL_AWS_ACCESS_KEY_ID=
ROSA_HCP_EPHEMERAL_AWS_SECRET_ACCESS_KEY=

# ── AWS (validate-core-ocp, validate-operator-live) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2

# ── IBM Cloud (validate-core-ocp IPI) ──
IBMCLOUD_APIKEY=
IC_API_KEY=

# ── GCP (validate-core-ocp IPI) ──
GCP_PROJECT=
GOOGLE_CLOUD_KEYFILE_JSON=

# ── Azure (validate-core-ocp IPI) ──
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_SERVICE_PRINCIPAL_CLIENT_ID=
AZURE_SERVICE_PRINCIPAL_CLIENT_SECRET=

# ── Multi-cluster (validate-findings, validate-operator-live) ──
HUB_KUBECONFIG=
SPOKE_KC=
ROSA_KC=

# ── Ledger signing (sign_merkle_root.py; docs/signing.md) ──
# 1 = validate_report.py warns on unsigned merkle roots; 0 (default) = signing fully opt-in
HARNESS_SIGNING_REQUIRED=0
# ── Harness configuration ──
# Runtime paths (workspace, analysis-results, progress-tracker, feeds-cache)
# live in $TRAUST_CONFIG_HOME/traust.yaml (locations:) — not here. See docs/setup.md §5.
# TRAUST_CONFIG_HOME=~/.traust/config
