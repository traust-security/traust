# Containerfile for Go-based repos (Linux-oriented Go projects)
#
# Build:
#   podman build -t backport-go:latest -f container/Containerfile .
#
# Usage:
#   bash run_backport.sh \
#       --config-dir ~/.cache/traust/backport-fix/configs \
#       --output-dir ~/.cache/traust/backport-fix/results \
#       --container-image backport-go:latest \
#       --repo /path/to/repo \
#       --amalgamator /path/to/amalgamator

# Pinned by digest (ubi9/ubi:latest resolved 2026-11-06); bump deliberately.
FROM registry.access.redhat.com/ubi9/ubi@sha256:1963e00991088221a3405be7eb315a3dbc0be0f1f7440f0bd537d481cf33c83e

ARG GO_VERSION=1.23.8
# Verified SHA-256 of the official go.dev archive, per architecture. A missing
# entry fails the build rather than installing an unverified tarball.
ARG GO_SHA256_AMD64=45b87381172a58d62c977f27c4683c8681ef36580abecd14fd124d24ca306d3f
ARG GO_SHA256_ARM64=9d6d938422724a954832d6f806d397cf85ccfde8c581c201673e50e634fdc992
ARG PYTHON_VERSION=3.12
# BuildKit/podman set TARGETARCH from the platform being built. Declared
# WITHOUT a default so the automatic value survives; a default would override
# it and an arm64 build would download the amd64 toolchain. The inline
# fallback covers builders that do not provide the automatic argument.
ARG TARGETARCH

# Install build essentials + Python 3.12 (UBI9 default is 3.9; the
# Amalgamator declares requires-python >=3.12)
RUN dnf install -y \
        git \
        make \
        gcc \
        glibc-devel \
        "python${PYTHON_VERSION}" \
        "python${PYTHON_VERSION}-pip" \
        "python${PYTHON_VERSION}-devel" \
        findutils \
        diffutils \
        which \
    && ln -sf "/usr/bin/python${PYTHON_VERSION}" /usr/bin/python3 \
    && ln -sf "/usr/bin/pip${PYTHON_VERSION}" /usr/bin/pip3 \
    && dnf clean all

# Install Go, verifying the published SHA-256 before extracting.
RUN set -eux; \
    arch="${TARGETARCH:-amd64}"; \
    case "$arch" in \
      amd64) sha="$GO_SHA256_AMD64" ;; \
      arm64) sha="$GO_SHA256_ARM64" ;; \
      *) echo "unsupported TARGETARCH '$arch' — add a pinned SHA-256 first" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz"; \
    echo "${sha}  /tmp/go.tgz" | sha256sum -c -; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm -f /tmp/go.tgz
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"
ENV GOPATH="/root/go"

# Amalgamator runtime dependencies: the top-level pins mirror the Amalgamator's
# pyproject.toml (pyyaml, colorama, claude-agent-sdk, litellm, anthropic[vertex];
# the vertex extra pulls google-auth for the CLAUDE_CODE_USE_VERTEX=1 path), and
# the COMPLETE transitive set is hash-pinned in container/requirements-amalgamator.txt,
# installed --no-deps. A later rebuild therefore cannot resolve a different (or
# compromised) release into a pipeline that runs untrusted code. Regenerate the
# file when the Amalgamator's dependencies change (instructions in its header).
COPY container/requirements-amalgamator.txt /tmp/requirements-amalgamator.txt
RUN python3 -m pip install --no-cache-dir --require-hashes --no-deps \
        -r /tmp/requirements-amalgamator.txt \
    && python3 -m pip check \
    && rm -f /tmp/requirements-amalgamator.txt

# traust + traust-core in their own venv, for `traust util safe-exec run`: the
# generator routes every build/test step through it (rule S10), so the target's
# build runs with a scrubbed environment. Kept apart from the Amalgamator's pins.
# Nothing is installed unpinned:
#   - registry packages: hash-pinned from traust's uv.lock
#     (container/requirements-traust.txt; regenerate with the uv export in its header);
#   - the four traust-security repos: fetched at commit SHAs — the uv.lock revisions,
#     and for traust a development commit carrying the safe-exec CLI
#     (tests/test_backport_container_pins.py keeps the ARGs equal to uv.lock);
#   - build backends, hash-pinned, builds run without isolation: hatchling
#     (container/requirements-build.txt) in a separate build venv for the three
#     libraries; setuptools (container/requirements-editable.txt) for traust.
# traust is an editable install of its source tree, so it finds harnessing/ and
# packs/ the way a checkout does.
ARG TRAUST_REF=e83e2dea1678160fc296e82b0a3e3e2487189e56
ARG TRAUST_CORE_REF=5b8dea0e6c714190c38c51719cd2e25cc946009b
ARG TRAUST_CONTRACTS_REF=485578cbe584ad224d57b2c7c778174c0b66ba7c
ARG TRAUST_LEDGER_REF=95fd75ed9b7f548322f528f1fd99263ed6733960
COPY container/requirements-traust.txt container/requirements-build.txt container/requirements-editable.txt /tmp/
RUN set -eux; \
    fetch() { \
      git init -q "/opt/src/$1"; \
      git -C "/opt/src/$1" fetch -q --depth 1 "https://github.com/traust-security/$1.git" "$2"; \
      git -C "/opt/src/$1" checkout -q --detach FETCH_HEAD; \
      test "$(git -C "/opt/src/$1" rev-parse HEAD)" = "$2"; \
    }; \
    fetch traust "$TRAUST_REF"; \
    fetch traust-core "$TRAUST_CORE_REF"; \
    fetch traust-contracts "$TRAUST_CONTRACTS_REF"; \
    fetch traust-ledger "$TRAUST_LEDGER_REF"; \
    python3 -m venv /opt/build; \
    /opt/build/bin/python -m pip install -q --no-cache-dir --require-hashes \
        -r /tmp/requirements-build.txt; \
    /opt/build/bin/python -m pip wheel -q --no-cache-dir --no-deps --no-build-isolation \
        -w /tmp/wheels /opt/src/traust-contracts /opt/src/traust-ledger /opt/src/traust-core; \
    python3 -m venv /opt/traust; \
    /opt/traust/bin/python -m pip install -q --no-cache-dir --require-hashes --no-deps \
        -r /tmp/requirements-traust.txt; \
    /opt/traust/bin/python -m pip install -q --no-cache-dir --no-deps /tmp/wheels/*.whl; \
    /opt/traust/bin/python -m pip install -q --no-cache-dir --require-hashes \
        -r /tmp/requirements-editable.txt; \
    /opt/traust/bin/python -m pip install -q --no-cache-dir --no-deps --no-build-isolation \
        -e /opt/src/traust; \
    /opt/traust/bin/python -m pip check; \
    /opt/traust/bin/python -m traust.cli util safe-exec list-profiles >/dev/null; \
    rm -rf /opt/build /tmp/wheels /tmp/requirements-*.txt

WORKDIR /workspace

COPY container/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
